{
  "manifest_version": 3,
  "name": "RASID Extension",
  "version": "1.0",
  "description": "Background bilingual ad-risk detection using RASID API",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RASID"
  }
}